@using Microsoft.AspNetCore.Components.Forms
@inject IJSRuntime Js
@inject NavigationManager Nav
@implements IAsyncDisposable

<section class="ar-experience" aria-label="Augmented reality viewer">
    <div class="ar-toolbar">
        <button type="button"
                class="btn primary"
                data-testid="enter-ar-button"
                @onclick="EnterArAsync"
                disabled="@_busy">
            Enter AR (WebXR)
        </button>
        <label class="file-label" data-testid="ifc-input">
            <span class="btn">Load IFC</span>
            <InputFile OnChange="OnIfcChangeAsync"
                       accept=".ifc"
                       class="sr-only" />
        </label>
        <span class="hint">Use <code>?preview=1</code> for desktop orbit preview (Playwright).</span>
    </div>

    <canvas @ref="_canvas"
            width="960"
            height="540"
            data-testid="ar-canvas"
            class="ar-canvas"></canvas>

    <p class="ar-status" data-testid="ar-status" role="status">@_status</p>
    @if (!string.IsNullOrEmpty(_ifcName))
    {
        <p class="ar-meta" data-testid="ifc-name">IFC: @_ifcName</p>
    }
</section>

@code {
    private readonly int _maxIfcBytes = 80 * 1024 * 1024;

    private ElementReference _canvas;
    private IJSObjectReference? _module;
    private string _status = "Initializing…";
    private string? _ifcName;
    private bool _busy;
    private bool _initialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _initialized)
            return;

        _initialized = true;
        try
        {
            var preview = Nav.Uri.Contains("preview=1", StringComparison.OrdinalIgnoreCase);
            var moduleUrl = Nav.ToAbsoluteUri("_content/BabylonAugmentedReality.Frontend/ar/ar-main.js");
            _module = await Js.InvokeAsync<IJSObjectReference>("import", moduleUrl.ToString());
            await _module.InvokeVoidAsync("init", _canvas, preview, Nav.BaseUri);
            _status = preview
                ? "Preview mode: orbit the ~6 ft placeholder (IFC replaces meshes when parsing succeeds)."
                : "Ready. Enter AR on a supported device, move your phone to find surfaces, then tap to place.";
        }
        catch (Exception ex)
        {
            _status = $"Viewer failed to start: {ex.Message}";
        }
    }

    private async Task EnterArAsync()
    {
        if (_module is null)
            return;

        _busy = true;
        try
        {
            var message = await _module.InvokeAsync<string>("enterAr");
            _status = message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OnIfcChangeAsync(InputFileChangeEventArgs e)
    {
        if (_module is null || e.FileCount == 0)
            return;

        var file = e.File;
        if (file.Size > _maxIfcBytes)
        {
            _status = $"IFC too large (max {_maxIfcBytes / (1024 * 1024)} MB).";
            return;
        }

        _busy = true;
        _ifcName = file.Name;
        _status = "Loading IFC…";
        try
        {
            await using var stream = file.OpenReadStream(_maxIfcBytes);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var b64 = Convert.ToBase64String(ms.ToArray());
            var message = await _module.InvokeAsync<string>("loadIfcBase64", b64);
            _status = message;
        }
        catch (Exception ex)
        {
            _status = $"IFC load failed: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose");
            }
            catch (JSDisconnectedException)
            {
                // Circuit gone during teardown.
            }

            await _module.DisposeAsync();
        }
    }
}
